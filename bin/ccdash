#!/bin/sh
# ccdash — control the local Claude Code dashboard server.
#   ccdash start | stop | restart | open | status | logs
set -e

# Resolve the repo root even when this script is invoked through a symlink on PATH.
SELF="$(realpath "$0")"
ROOT="$(cd "$(dirname "$SELF")/.." && pwd -P)"
PORT="${CCDASH_PORT:-4321}"
DATA_DIR="${CCDASH_DATA_DIR:-$HOME/.ccdash}"
PID_FILE="$DATA_DIR/server.pid"
LOG_FILE="$DATA_DIR/server.log"
URL="http://localhost:$PORT"

usage() {
  cat <<EOF
Usage: ccdash <command>

Commands:
  start     Start the dashboard server in the background
  stop      Stop the server
  restart   Stop, then start
  open      Open the dashboard in your browser (starts the server if needed)
  status    Show whether the server is running
  logs      Follow the server log

Dashboard: $URL   Log: $LOG_FILE
EOF
}

# Prints the server's pid if it is running. Falls back to whatever ccdash process
# holds the port, so a server started some other way can still be stopped.
server_pid() {
  if [ -f "$PID_FILE" ]; then
    pid="$(cat "$PID_FILE")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "$pid"
      return 0
    fi
    rm -f "$PID_FILE"
  fi
  for pid in $(lsof -ti "tcp:$PORT" -sTCP:LISTEN 2>/dev/null); do
    if ps -o command= -p "$pid" | grep -q "server/src/index.ts"; then
      echo "$pid"
      return 0
    fi
  done
  return 1
}

build_if_needed() {
  cd "$ROOT"
  [ -d node_modules ] || npm install --silent
  if [ ! -f web/dist/index.html ] || [ -n "$(find web/src shared web/index.html -newer web/dist/index.html -print -quit)" ]; then
    echo "Building the web app…"
    npm run build --silent >/dev/null
  fi
}

start() {
  if pid="$(server_pid)"; then
    echo "ccdash is already running (pid $pid) at $URL"
    return 0
  fi
  if lsof -ti "tcp:$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Port $PORT is in use by another program. Free it, or run with CCDASH_PORT=<port>." >&2
    exit 1
  fi
  build_if_needed
  mkdir -p "$DATA_DIR"
  cd "$ROOT"
  nohup node server/src/index.ts >>"$LOG_FILE" 2>&1 &
  echo $! >"$PID_FILE"
  # Wait for the server to answer before reporting success.
  i=0
  while [ $i -lt 50 ]; do
    if curl -s -o /dev/null "$URL/api/overview"; then
      echo "ccdash started (pid $(cat "$PID_FILE")) at $URL"
      return 0
    fi
    if ! kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then break; fi
    sleep 0.2
    i=$((i + 1))
  done
  echo "ccdash failed to start. Last lines of $LOG_FILE:" >&2
  tail -n 15 "$LOG_FILE" >&2
  rm -f "$PID_FILE"
  exit 1
}

stop() {
  if ! pid="$(server_pid)"; then
    echo "ccdash is not running"
    return 0
  fi
  kill "$pid"
  i=0
  while kill -0 "$pid" 2>/dev/null && [ $i -lt 25 ]; do
    sleep 0.2
    i=$((i + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid"; fi
  rm -f "$PID_FILE"
  echo "ccdash stopped"
}

status() {
  if pid="$(server_pid)"; then
    echo "ccdash is running (pid $pid, up $(ps -o etime= -p "$pid" | tr -d ' ')) at $URL"
  else
    echo "ccdash is not running"
    return 3
  fi
}

case "${1:-}" in
  start) start ;;
  stop) stop ;;
  restart) stop && start ;;
  open)
    server_pid >/dev/null || start
    open "$URL"
    ;;
  status) status ;;
  logs) touch "$LOG_FILE" 2>/dev/null; exec tail -f "$LOG_FILE" ;;
  -h | --help | help | "") usage ;;
  *)
    echo "ccdash: unknown command '$1'" >&2
    usage >&2
    exit 1
    ;;
esac
